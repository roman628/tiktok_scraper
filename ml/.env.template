# TikTok Performance Predictor Environment Configuration Template
# Copy this file to .env and customize for your environment

# ====================================================================
# ENVIRONMENT SETTINGS
# ====================================================================

# Deployment environment (local|development|production|docker)
ENVIRONMENT=local

# ====================================================================
# DATA CONFIGURATION
# ====================================================================

# Path to your data file (master2.json)
# Leave empty for auto-discovery, which searches:
# - ../data/master2.json (project structure)
# - ../master2.json (root level)
# - ./data/master2.json (relative)
# - /data/master2.json (Docker volume)
DATA_PATH=

# Alternative: specify a data volume for Docker deployments
# DATA_VOLUME=/mnt/data

# ====================================================================
# MODEL CONFIGURATION
# ====================================================================

# Model file name
MODEL_NAME=snoo.pkl

# Path to model file (leave empty for auto-discovery)
# Auto-discovery searches:
# - ../models/snoo.pkl
# - ./models/snoo.pkl
# - /models/snoo.pkl (Docker)
MODEL_PATH=

# Model version tag (for versioning)
MODEL_VERSION=latest

# Auto-reload model on file changes (development only)
MODEL_AUTO_RELOAD=false

# Model cache size (number of predictions to cache)
MODEL_CACHE_SIZE=100

# ====================================================================
# API SERVER CONFIGURATION
# ====================================================================

# API server host and port
API_HOST=0.0.0.0
API_PORT=8080

# Number of worker processes (production only)
API_WORKERS=4

# Request timeout in seconds
API_TIMEOUT=300

# Maximum requests per worker before restart (production)
API_MAX_REQUESTS=1000

# ====================================================================
# LOGGING CONFIGURATION
# ====================================================================

# Log level (DEBUG|INFO|WARN|ERROR)
LOG_LEVEL=INFO

# Log format (json|text)
# Use 'json' for production, 'text' for development
LOG_FORMAT=text

# Log directory (relative to ml/ directory)
LOG_DIR=./logs

# Log file name
LOG_FILE=api.log

# Maximum log file size before rotation
LOG_MAX_SIZE=100M

# Number of backup log files to keep
LOG_BACKUP_COUNT=5

# ====================================================================
# HEALTH CHECK CONFIGURATION
# ====================================================================

# Enable health check endpoints
HEALTH_CHECK_ENABLED=true

# Health check endpoint paths
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready
LIVENESS_CHECK_PATH=/alive

# ====================================================================
# PERFORMANCE CONFIGURATION
# ====================================================================

# Enable response caching
CACHE_ENABLED=true

# Cache time-to-live in seconds
CACHE_TTL=3600

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Maximum request content length (bytes)
# Default: 16MB (16777216 bytes)
MAX_CONTENT_LENGTH=16777216

# ====================================================================
# DOCKER-SPECIFIC CONFIGURATION
# ====================================================================

# These settings are automatically applied when running in Docker
# You can override them by setting ENVIRONMENT=docker

# DOCKER_DATA_PATH=/data/master2.json
# DOCKER_MODEL_PATH=/models/snoo.pkl
# DOCKER_LOG_DIR=/logs
# DOCKER_API_WORKERS=4

# ====================================================================
# PRODUCTION CONFIGURATION
# ====================================================================

# These settings are automatically applied in production
# You can override them by setting ENVIRONMENT=production

# PROD_LOG_FORMAT=json
# PROD_LOG_LEVEL=WARN
# PROD_API_WORKERS=8
# PROD_CACHE_TTL=7200
# PROD_MODEL_AUTO_RELOAD=false

# ====================================================================
# DEVELOPMENT CONFIGURATION
# ====================================================================

# These settings are automatically applied in development
# You can override them by setting ENVIRONMENT=development

# DEV_LOG_FORMAT=text
# DEV_LOG_LEVEL=DEBUG
# DEV_API_WORKERS=1
# DEV_MODEL_AUTO_RELOAD=true
# DEV_CACHE_TTL=60

# ====================================================================
# PYTHON CONFIGURATION
# ====================================================================

# Python command to use (python, python3, or full path)
# Leave empty to auto-detect
PYTHON_CMD=

# ====================================================================
# NOTES
# ====================================================================

# 1. Environment variables override settings in this file
# 2. Command-line arguments override environment variables
# 3. Use 'validate' command to test your configuration:
#    ./start_api.sh validate
# 4. Use 'config' command to see current configuration:
#    ./start_api.sh config
# 5. For Docker deployments, mount volumes at standard paths:
#    - /data for data files
#    - /models for model files
#    - /logs for log files