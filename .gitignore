# IGNORE EVERYTHING BY DEFAULT
*

# THEN EXPLICITLY ALLOW ESSENTIAL SYSTEM COMPONENTS

# Core System Files
!main.py
!requirements.txt
!package.json
!CLAUDE.md
!README*.md
!.gitignore

# Core Application Directory
!core/
!core/**

# ML Model (Performance Prediction)
!ml_model/
!ml_model/**

# Essential Tools (Collection, Cleanup, Analysis)
!tools/
!tools/**

# Essential Data Files
!master2.json
!urls.txt

# Model Files
!models/
!models/**

# Essential Scripts
!run_*.sh
!start-*.sh

# Configuration Examples
!*.example
!*.env.example

# Documentation
!documentation/
!documentation/**

# Firefox Extension (URL Collector)
!firefox_extension/
!firefox_extension/**

# TikTok Insights (Analysis Output)
!tiktok_insights/
!tiktok_insights/**

# Video Analysis
!video_analysis/
!video_analysis/**

# Keep any Python init files
!__init__.py

# But ignore sensitive/large files
downloads/
temp_downloads/
output/
test_output/
backups/
debug-logs/
multiprocess-logs/
venv/
node_modules/
__pycache__/

