# TikTok Scraper - Minimal Docker Environment Variables
# Copy this file to .env and update with your values

# Database Credentials (Required)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_password_in_production
POSTGRES_PORT=5432

# Django Security (Required for production)
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True  # Set to False in production
ALLOWED_HOSTS=*    # Set to your domain in production

# API Keys (Optional - only if using these features)
MS_TOKEN=          # TikTok MS_TOKEN for comment extraction
GEMINI_API_KEY=    # Google Gemini API for category discovery