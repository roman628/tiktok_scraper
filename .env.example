# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_password_in_production
POSTGRES_PORT=5432

# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=False  # Set to True for development
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# TikTok API Configuration
MS_TOKEN=  # Your TikTok MS_TOKEN for comment extraction (optional)

# AI API Keys
GEMINI_API_KEY=  # Google Gemini API key for categorization (optional)

# Collector Configuration
COLLECTOR_WORKERS=4  # Number of parallel workers for collection
MAX_BATCH_SIZE=10    # Maximum batch size for processing

# Display Configuration
DISPLAY_MODE=auto  # Options: rich, simple, auto
RAW_LOG=false      # Save raw output to timestamped log file

# ML Configuration
ML_MIN_DURATION=45           # Minimum video duration for ML training
ML_MIN_WORDS=150            # Minimum words in transcription for training
ML_FILTER_REDDIT_LIKE=true  # Focus on Reddit-style content

# Performance Settings
MAX_MEMORY_MB=8192  # Maximum memory usage in MB
CLEANUP_INTERVAL=300  # Cleanup interval in seconds