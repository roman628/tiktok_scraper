# TikTok Scraper Docker Environment Configuration

# Python Environment
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Selenium Configuration
SELENIUM_HUB_HOST=selenium-hub
SELENIUM_HUB_PORT=4444
SELENIUM_GRID_URL=http://selenium-hub:4444/wd/hub

# Browser Configuration
CHROME_OPTIONS=--headless --no-sandbox --disable-dev-shm-usage --disable-gpu --window-size=1920,1080
FIREFOX_OPTIONS=--headless --width=1920 --height=1080

# Display for X11 (if needed)
DISPLAY=:99

# API Configuration
PREDICTOR_API_HOST=0.0.0.0
PREDICTOR_API_PORT=8000
INSIGHTS_DASHBOARD_HOST=0.0.0.0
INSIGHTS_DASHBOARD_PORT=8080

# Worker Configuration
DEFAULT_WORKERS=3
MAX_WORKERS=6

# File Paths (Container paths)
DATA_DIR=/app/data
DOWNLOADS_DIR=/app/downloads
MODELS_DIR=/app/models
OUTPUTS_DIR=/app/outputs
BACKUPS_DIR=/app/backups
LOGS_DIR=/app/logs

# Main Files
MASTER_JSON_FILE=/app/master2.json
URLS_FILE=/app/urls.txt
KEYWORD_MAP_FILE=/app/keyword_score_map.json

# ML Model Configuration
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# TikTok API Configuration (add your credentials)
# TIKTOK_API_KEY=your_api_key_here
# TIKTOK_SECRET=your_secret_here

# Reddit API Configuration (add your credentials)
# REDDIT_CLIENT_ID=your_client_id_here
# REDDIT_CLIENT_SECRET=your_client_secret_here
# REDDIT_USER_AGENT=TikTokScraper/1.0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Performance Settings
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
NUMEXPR_MAX_THREADS=4